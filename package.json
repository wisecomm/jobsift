{
  "name": "jobsift",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "pack": "npm run build && rm -f jobsift-store.zip && (cd dist && zip -r ../jobsift-store.zip .)",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify:workflow": "vitest run tests/classificationWorkflow.test.ts",
    "verify": "npm run typecheck && npm test && npm run build",
    "collect:live": "tsx scripts/collect-live.ts"
  },
  "dependencies": {
    "idb": "^8.0.4",
    "node-html-parser": "^9.0.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "fake-indexeddb": "^6.2.8",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
